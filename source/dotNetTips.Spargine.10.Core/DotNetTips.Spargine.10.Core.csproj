<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<AnalysisLevel>latest-recommended</AnalysisLevel>
	<AnalysisMode>AllEnabledByDefault</AnalysisMode>
	<ApplicationIcon>SPARGINE-ICON-GRAPHIC-SMALL.ico</ApplicationIcon>
	<AssemblyName>$(MSBuildProjectName)</AssemblyName>
	<AssemblyTitle>DotNetTips.Spargine.10.Core</AssemblyTitle>
	<AssemblyVersion>2026.10.4.23</AssemblyVersion>
	<Authors>David McCarter</Authors>
	<AutoIncrementPackageRevision>true</AutoIncrementPackageRevision>
	<BaseOutputPath>..\..\AppBin</BaseOutputPath>
	<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
	<Company>dotNetTips.com - McCarter Consulting</Company>
	<Configurations>Debug;DebugTrim;Release</Configurations>
	<Copyright>McCarter Consulting (David McCarter)</Copyright>
	<Description>Core types and helper methods for Spargine.</Description>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
	<EnablePackageValidation>false</EnablePackageValidation>
	<EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
	<PublishTrimmed>true</PublishTrimmed>
	<ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	<FileVersion>2026.10.4.23</FileVersion>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	<ImplicitUsings>enable</ImplicitUsings>
	<IncludeSymbols>true</IncludeSymbols>
	<LangVersion>latest</LangVersion>
	<NeutralLanguage>en-US</NeutralLanguage>
	<Nullable>enable</Nullable>
	<PackageIcon>SPARGINE-ICON-GRAPHIC-SMALL.png</PackageIcon>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<PackageProjectUrl>https://bit.ly/Spargine</PackageProjectUrl>
	<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	<PackageTags>David McCarter, dotNetDave, dotNetTips.com, Spargine</PackageTags>
	<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
	<Product>DotNetTips.Spargine.10</Product>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<RepositoryUrl>https://github.com/RealDotNetDave/dotNetTips.Spargine.10</RepositoryUrl>
	<RootNamespace>DotNetTips.Spargine.Core</RootNamespace>
	<RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
	<RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
	<SignAssembly>false</SignAssembly>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<TargetFramework>net10.0</TargetFramework>
	<Title>DotNetTips.Spargine.10.Core</Title>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2046;IL2057;IL2060;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2095;IL2104;IL2125</WarningsNotAsErrors>
	<Version>2026.10.4.23</Version>
  </PropertyGroup>
  <PropertyGroup>
	<NuGetAudit>true</NuGetAudit>
	<NuGetAuditMode>all</NuGetAuditMode>
	<NuGetAuditLevel>low</NuGetAuditLevel>
	<WarningsAsErrors Condition="$(ContinuousIntegrationBuild) == 'true' OR '$(Configuration)' == 'Release'">(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
	<PackageReleaseNotes>
	  --JAN 2026: Initial .NET 10 release.
	  --APR 2026: Updated dependencies and added new helper methods.
	</PackageReleaseNotes>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<OutputPath>..\..\AppBin\</OutputPath>
	<DocumentationFile>..\..\AppBin\dotNetTips.Spargine.10.Core.xml</DocumentationFile>
	<WarningLevel>9999</WarningLevel>
	<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	<Optimize>false</Optimize>
	<NoWarn />
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugTrim|AnyCPU'">
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<OutputPath>..\..\AppBin\</OutputPath>
	<DocumentationFile>..\..\AppBin\dotNetTips.Spargine.10.Core.xml</DocumentationFile>
	<WarningLevel>9999</WarningLevel>
	<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	<Optimize>false</Optimize>
	<NoWarn />
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<OutputPath>..\..\AppBin\</OutputPath>
	<DocumentationFile>..\..\AppBin\dotNetTips.Spargine.10.Core.xml</DocumentationFile>
	<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	<WarningLevel>9999</WarningLevel>
	<Optimize>true</Optimize>
	<NoWarn />
  </PropertyGroup>
  <ItemGroup>
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
	<Compile Remove="IEasyDisposable.cs" />
	<Compile Remove="Security\BarCode.cs" />
  </ItemGroup>
  <ItemGroup>
	<Content Include="SPARGINE-ICON-GRAPHIC-SMALL.ico" />
  </ItemGroup>
  <ItemGroup>
	<EmbeddedResource Include="SPARGINE-ICON-GRAPHIC-SMALL.png">
	  <Pack>true</Pack>
	  <PackagePath>\</PackagePath>
	  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	</EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="IDisposableAnalyzers" Version="4.0.8">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
	<PackageReference Include="Microsoft.ApplicationInsights" Version="3.1.0" />
	<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
	<PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
	<PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
	<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.203" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
	<Compile Update="Properties\Resources.Designer.cs">
	  <DesignTime>True</DesignTime>
	  <AutoGen>True</AutoGen>
	  <DependentUpon>Resources.resx</DependentUpon>
	</Compile>
  </ItemGroup>
  <ItemGroup>
	<EmbeddedResource Update="Properties\Resources.resx">
	  <Generator>ResXFileCodeGenerator</Generator>
	  <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	</EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
	<None Include="..\..\LICENSE.txt">
	  <Pack>True</Pack>
	  <PackagePath>\</PackagePath>
	</None>
	<None Include="..\..\README.md">
	  <Pack>True</Pack>
	  <PackagePath>\</PackagePath>
	</None>
  </ItemGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
	<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>